# ============================================================================
# NEXUS AI - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ----------------------------------------------------------------------------
# AI API Keys (At least ONE is required)
# ----------------------------------------------------------------------------

# Groq API Key (Primary - Fast and reliable)
# Get yours at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini API Key (Fallback - Google's AI)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ----------------------------------------------------------------------------
# Voice Recognition Settings (Optional - Defaults provided)
# ----------------------------------------------------------------------------

# Energy threshold for voice detection (150-600)
# Lower = more sensitive, Higher = less sensitive
VOICE_ENERGY_MIN=150
VOICE_ENERGY_MAX=600

# Pause threshold in seconds (how long to wait for speech continuation)
VOICE_PAUSE_THRESHOLD=0.8

# Preferred TTS voice (macOS voice name, e.g., Daniel, Samantha, Alex)
VOICE_PREFERRED=Daniel

# ----------------------------------------------------------------------------
# Weather Service (Optional)
# ----------------------------------------------------------------------------

# OpenWeatherMap API Key
# Get yours at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
DEFAULT_CITY=Mumbai

# ----------------------------------------------------------------------------
# Email Configuration (Optional - For email features)
# ----------------------------------------------------------------------------

# Gmail address for sending/receiving emails
EMAIL_ADDRESS=your_email@gmail.com

# Gmail App Password (NOT your regular password!)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_gmail_app_password_here

# IMAP server (default is Gmail)
EMAIL_IMAP_SERVER=imap.gmail.com

# ----------------------------------------------------------------------------
# System Settings (Optional)
# ----------------------------------------------------------------------------

# Enable debug mode (true/false)
DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
